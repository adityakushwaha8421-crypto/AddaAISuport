# Copy to .env and fill in. NEVER commit .env. Secrets live only here (or your secret manager).

NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=false
LOG_FILE=logs/agent.log

# ── Telegram (personal account) ──────────────────────────────────────────
# API id/hash from https://my.telegram.org → API development tools.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_from_my_telegram_org
TELEGRAM_PHONE=+91XXXXXXXXXX
# Session string written by `npm run telegram:session` (a logged-in device: keep private).
TELEGRAM_SESSION=
# Alternative: encrypted session file written by `npm run telegram:login`, unlocked with SESSION_ENCRYPTION_KEY.
TELEGRAM_SESSION_FILE=secrets/telegram.session.enc
# SESSION_ENCRYPTION_KEY=run: openssl rand -hex 32
INSTANCE_LOCK_FILE=secrets/agent.lock
# Mirror of the /boton /botoff state so OFF survives a full restart even with STORE=memory.
BOT_STATE_FILE=data/bot-state.json
# Telegram user ids allowed to run /boton /botoff /restart by messaging the account (the owner can always use Saved Messages).
ADMIN_TELEGRAM_IDS=
# Team chats the transport tells apart from customer chats (received, never treated as a customer's).
SUPPORT_GROUP_CHAT_ID=
EXPORT_BOT_ID=
# Only these user ids / @usernames count as customers (testing). Empty = everyone not filtered below.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_IGNORE_CONTACTS=true
TELEGRAM_SEND_RATE=20
TELEGRAM_CHAT_SEND_RATE=1

# ── Database ─────────────────────────────────────────────────────────────
STORE=postgres
DATABASE_URL=postgres://user:password@localhost:5432/fa_support
DATABASE_POOL_MAX=10

# ── OpenAI (client kept for future workflows; nothing calls it today) ─────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
# OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_CONCURRENCY=8

# ── Ops ──────────────────────────────────────────────────────────────────
HTTP_PORT=9464
HTTP_HOST=127.0.0.1
