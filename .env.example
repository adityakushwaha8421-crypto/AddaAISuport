# Copy to .env and fill in. NEVER commit .env. Secrets live only here (or your secret manager).

NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=false
LOG_FILE=logs/agent.log

# ── Telegram (personal account) ──────────────────────────────────────────
# API id/hash from https://my.telegram.org → API development tools, then run `npm run telegram:login` once.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_from_my_telegram_org
TELEGRAM_PHONE=+91XXXXXXXXXX
# Encrypted (AES-256-GCM) session file, written by `npm run telegram:login`.
TELEGRAM_SESSION_FILE=secrets/telegram.session.enc
# 32-byte key (64 hex chars) or a long passphrase. Generate: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=run: openssl rand -hex 32
# Support group where human handoffs are posted (the account must be a member). e.g. -1001234567890
SUPPORT_GROUP_CHAT_ID=-1001234567890
# Export bot: receives each case's requested details and files once they are all in
EXPORT_BOT_ID=
# Minutes the agent stays silent in a chat after a human replied from the support group / the phone.
HUMAN_TAKEOVER_MINUTES=60
REPLY_ONLY_TO_UNREAD=true

# ── Database ─────────────────────────────────────────────────────────────
STORE=postgres
DATABASE_URL=postgres://user:password@localhost:5432/fa_support
DATABASE_POOL_MAX=10

# ── OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
# OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=45000
# llm = natural phrasing (guarded, falls back to templates); template = deterministic phrasing only
RESPONSE_MODE=llm

# ── Admin panel (browser automation) ─────────────────────────────────────
# playwright | fixture (dev data from ADMIN_FIXTURE_FILE) | disabled (everything goes to humans)
ADMIN_MODE=disabled
ADMIN_BASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_CONFIG_FILE=config/admin.json
ADMIN_FIXTURE_FILE=config/admin-fixtures.example.json
ADMIN_STORAGE_STATE_FILE=secrets/admin-storage-state.json
ADMIN_HEADLESS=true
ADMIN_TIMEOUT_MS=30000
ADMIN_CACHE_TTL_SECONDS=120
# ADMIN_BROWSER_CHANNEL=chrome
# ADMIN_BROWSER_PATH=

# ── Behaviour ────────────────────────────────────────────────────────────
TURN_DEBOUNCE_MS=1500
TURN_MAX_WAIT_MS=5000
MAX_CONCURRENT_TURNS=8
MAX_ASKS_PER_SLOT=2
HISTORY_MESSAGES=20
CASE_IDLE_CLOSE_HOURS=48
WITHDRAWAL_PROCESSING_SLA_HOURS=24
# Regex (JS syntax). Default: 10-digit Indian mobile number.
REGISTRATION_NUMBER_PATTERN=(?<![\d])[6-9]\d{9}(?![\d])
WITHDRAWAL_ID_PATTERN=\b(?:WD|WDR|WID)[-_]?\d{3,}(?:[-_]\d{2,})*\b
ORDER_ID_PATTERN=\b(?:ORD|ORDER|DEP|TXN)[-_]?(?=[A-Z0-9]*\d)[A-Z0-9]{4,}(?:[-_][A-Z0-9]+)*\b
# Optional: enables screen-recording analysis
FFMPEG_PATH=
STYLE_GUIDE_FILE=config/style/fa_chat_style.json
KNOWLEDGE_FILE=config/knowledge.json

# ── Ops ──────────────────────────────────────────────────────────────────
# Scaling: all (default) | gateway | worker — see README "Running at scale"
ROLE=all
INTERNAL_TOKEN=
GATEWAY_URL=
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=180
OPENAI_MAX_CONCURRENCY=8
TELEGRAM_SEND_RATE=20
TELEGRAM_CHAT_SEND_RATE=1
HTTP_PORT=9464
HTTP_HOST=127.0.0.1
HANDOFF_RETRY_INTERVAL_SECONDS=60
HANDOFF_MAX_ATTEMPTS=10

ADMIN_TELEGRAM_IDS=
